# ==============================================================================
# KargoPilot v6.5.0 - MÜSTƏQİL SERVER REJİMİ (Self-Hosted / On-Premise)
# ==============================================================================
# Müstəqil Server (Self-Hosted) rejimində bütün FİN kodları, şifrələr, WhatsApp
# sessiyaları, daşıyıcı açarları və gömrük məlumatları yalnız öz serverinizdə qalır.
# Heç bir məlumat KargoPilot mərkəzi infrastrukturuna ötürülmür.
# ==============================================================================

DEPLOYMENT_MODE=sovereign
READ_ONLY_SAFE_MODE=true
TELEMETRY_ENABLED=false
ALLOW_EXTERNAL_REPORTING=false

# --- Cryptographic Keys (Auto-generated on install) ---
# Generate using: openssl rand -hex 32
JWT_SECRET_KEY=change_me_with_openssl_rand_hex_32_jwt_key
JWT_REFRESH_SECRET_KEY=change_me_with_openssl_rand_hex_32_refresh_key
MASTER_VAULT_AES_KEY=change_me_with_openssl_rand_hex_32_aes256_key

# --- Data Storage ---
DATA_DIR=/data/kargopilot
DB_PATH=/data/kargopilot/kargopilot.db
INVOICE_DIR=/data/kargopilot/invoices
LOG_DIR=/data/kargopilot/logs

# --- Server Binding ---
PORT=48481
HOST=127.0.0.1

# --- SmartCustoms Read-Only & DGK 300$ Quota Bridge ---
MONTHLY_CUSTOMS_QUOTA_USD=300.0
CBAR_USD_RATE=1.7000
CBAR_TRY_RATE=0.0485
CBAR_CNY_RATE=0.2380

# --- WhatsApp Müstəqil Server (Self-Hosted) Bot Gateway ---
WA_SIDECAR_URL=http://wa-sidecar:3100
WA_SESSION_DIR=/data/kargopilot/wa_sessions
WA_ADMIN_PHONE=+994501234567

# --- Default Admin Bootstrapping ---
INITIAL_SUPERADMIN_FIN=7KP2026
INITIAL_SUPERADMIN_NAME=Admin User
INITIAL_SUPERADMIN_PHONE=+994501234567
INITIAL_SUPERADMIN_EMAIL=admin@kargopilot.local
INITIAL_SUPERADMIN_PASSWORD=change_me_immediately_on_first_login
