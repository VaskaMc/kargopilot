# ==============================================================================
# KargoPilot v6.5.0 — Environment Configuration Template (Cloud & Self-Hosted)
# Zero real secrets or production IPs. Copy to .env and customize for your node.
# ==============================================================================

# --- Application & Dual-Hosting Mode ---
APP_ENV=production
DEBUG=false
DEPLOYMENT_MODE=managed_cloud
TELEMETRY_ENABLED=false
HOST=127.0.0.1
PORT=48481

# --- Cryptographic & Session Vault Keys (Generate via: openssl rand -hex 32) ---
JWT_SECRET_KEY=replace_with_openssl_rand_hex_32_jwt_secret
JWT_REFRESH_SECRET_KEY=replace_with_openssl_rand_hex_32_refresh_secret
FERNET_VAULT_KEY=replace_with_fernet_base64_32byte_encryption_key

# --- Database & Storage ---
DATABASE_URL=sqlite:///./data/pcs.db
DB_PATH=/data/pcs/pcs.db

# --- Consignee & DGK 300$ Quota Settings ---
DEFAULT_FIN=7KP2026
DEFAULT_PHONE=+994501234567
MONTHLY_CUSTOMS_QUOTA_USD=300.0
CBAR_USD_RATE=1.7000
CBAR_TRY_RATE=0.0485
CBAR_CNY_RATE=0.2380

# --- SmartCustoms (e.customs.gov.az) Read-Only Safe Mode ---
READ_ONLY_SAFE_MODE=true
SMARTCUSTOMS_AUTH_MODE=sima_readonly
ASAN_IMZA_PHONE=+994501234567
ASAN_USER_ID=000000

# --- WhatsApp Notification Gateway (Channel 4) ---
WA_GATEWAY_ENABLED=true
WA_SIDECAR_URL=http://127.0.0.1:3100
WA_SESSION_DIR=/data/kargopilot/wa_sessions
WA_DEFAULT_ALERT_PARCEL_ARRIVAL=true
WA_DEFAULT_ALERT_CUSTOMS_300=true
WA_DEFAULT_ALERT_SESSION_EXPIRY=true

# --- External Store & Carrier Vault Placeholders ---
STAREX_USERNAME=demo@kargopilot.az
CAMEX_COOKIE=demo_session_cookie_placeholder
DYNAMEX_TOKEN=demo_token_placeholder
LIMAK_TOKEN=demo_token_placeholder
