{
  "manifest_version": 3,
  "name": "KargoPilot v6.5 — 1-Klik Quick-Bridge Sessiya Körpüsü",
  "short_name": "KargoPilot v6.5",
  "version": "6.5.0",
  "description": "Trendyol, Temu, Starex və SmartCustoms (Bəyannaməsiz Read-Only 300$ Kvota) sessiyalarını 1 kliklə Bulud və ya Öz Serverinizə (Self-Hosted) bağlayın.",
  "permissions": [
    "cookies",
    "activeTab",
    "storage",
    "scripting"
  ],
  "host_permissions": [
    "*://*.trendyol.com/*",
    "*://*.temu.com/*",
    "*://*.amazon.com/*",
    "*://*.aliexpress.com/*",
    "*://*.starex.az/*",
    "*://*.camex.az/*",
    "*://*.limak.az/*",
    "*://*.dynamex.az/*",
    "*://*.customs.gov.az/*",
    "http://127.0.0.1:48481/*",
    "http://localhost:48481/*",
    "https://kargopilot.az/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "KargoPilot v6.5 Quick-Bridge",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.trendyol.com/*",
        "*://*.temu.com/*",
        "*://*.starex.az/*",
        "*://*.camex.az/*",
        "*://*.limak.az/*",
        "*://*.dynamex.az/*",
        "*://*.customs.gov.az/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
